<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
        <!-- The reminder's on/off + time is meaningless without the WorkManager schedule
             (lives in noBackupFilesDir, never backed up) and the POST_NOTIFICATIONS grant
             (never transfers on restore), both of which restoring alone can't recreate. -->
        <exclude domain="sharedpref" path="reminder_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Same reasoning as the cloud-backup exclude above: device-to-device transfer
             is a separate mechanism and defaults to transferring everything too. -->
        <exclude domain="sharedpref" path="reminder_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>