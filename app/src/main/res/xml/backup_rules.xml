<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
    <!-- The reminder's on/off + time is meaningless without the WorkManager schedule
         (lives in noBackupFilesDir, never backed up) and the POST_NOTIFICATIONS grant
         (never transfers on restore), both of which restoring alone can't recreate. -->
    <exclude domain="sharedpref" path="reminder_prefs.xml"/>
</full-backup-content>